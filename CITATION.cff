    given-names: "Minh Trí"
    alias: Kayden
    email: hello@trizenx.com
repository-code: "https://github.com/TrizenX/viparse"
url: "https://viparse.trizenx.com"
license: MIT
keywords:
  - vietnamese
  - rag
  - document-parsing
  - tcvn3
  - vni
  - viscii
  - unicode-nfc
